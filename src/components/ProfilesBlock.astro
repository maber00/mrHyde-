---
import { Image } from "astro:assets";
import manuelPhoto from "../assets/manuel.webp";
import anaPhoto from "../assets/ana.jpg";
import davidPhoto from "../assets/david.jpg";
import justiciaBg from "../assets/justicia.jpg";

export interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const copy =
  lang === "es"
    ? {
        sectionLabel: "El Equipo",
        bioOpen: "Ver biografía",
        bioClose: "Cerrar",
        sectionTitle: "QUIÉNES",
        sectionTitleOutline: "SOMOS",
        manuel: {
          role: "Dirección Creativa · CTO",
          name: "Manuel\nBedoya",
          bio: "Filmmaker y postproductor con años de experiencia en canales de TV, productoras y startups. Ha trabajado con diferentes compañias cómo son Quala, Colpatria, Bonice y Alianza Team. Desde 2018 integra tecnología y sistemas al proceso audiovisual — combinando lenguaje cinematográfico con los modelos de IA más avanzados del mercado.",
          tags: ["Dirección", "Post-producción", "AI Workflows", "Motion", "Color"],
        },
        ana: {
          role: "Estrategia · Negocio · Crecimiento",
          name: "Ana\nPrieto",
          bio: "Define la lógica de negocio detrás de cada pieza: a quién le habla, qué tiene que mover y cómo se mide — antes de que exista la primera toma. Traduce objetivos de crecimiento en decisiones de contenido: posicionamiento, narrativa y canales. En Sr. Hide conecta la producción audiovisual con el negocio: convierte contenido en resultado medible.",
          tags: ["Estrategia", "Growth", "Posicionamiento", "Métricas", "LATAM"],
        },
        david: {
          role: "Dirección de Arte · Publicidad · Postproducción",
          name: "David\nRodríguez",
          bio: "Publicista, director de arte y postproductor con experiencia en televisión y en contenido para marcas de reconocimiento nacional. Ha creado y dirigido piezas para Falabella, Arroz Diana, Brandy Domecq y Seguros Falabella. Desde 2020 integra dirección de arte y lenguaje cinematográfico con herramientas de IA — explorando nuevas formas de construir imagen para lo que las marcas necesitan hoy.",
          tags: ["Dirección de Arte", "Publicidad", "Post-producción", "AI Workflows", "Branding"],
        },
      }
    : {
        sectionLabel: "The Team",
        bioOpen: "Read bio",
        bioClose: "Close",
        sectionTitle: "WHO",
        sectionTitleOutline: "WE ARE",
        manuel: {
          role: "Creative Direction · CTO",
          name: "Manuel\nBedoya",
          bio: "Filmmaker and post-producer with years of experience across TV channels, production companies and startups. Has directed commercials for Quala, Casa Luker, Bonice and Alianza Team. Since 2018 he integrates technology and systems into the audiovisual process — combining cinematic language with the most advanced AI models on the market.",
          tags: ["Direction", "Post-production", "AI Workflows", "Motion", "Color"],
        },
        ana: {
          role: "Strategy · Business · Growth",
          name: "Ana\nPrieto",
          bio: "She defines the business logic behind every piece: who it speaks to, what it has to move and how it gets measured — before the first frame exists. She turns growth objectives into content decisions: positioning, narrative and channels. At Sr. Hide she connects audiovisual production with the business: turning content into measurable results.",
          tags: ["Strategy", "Growth", "Positioning", "Metrics", "LATAM"],
        },
        david: {
          role: "Art Direction · Advertising · Post-production",
          name: "David\nRodríguez",
          bio: "Advertising creative, art director and post-producer with experience in television and in content for nationally recognised brands. He has created and directed work for Falabella, Arroz Diana, Brandy Domecq and Seguros Falabella. Since 2020 he integrates art direction and cinematic language with AI tools — exploring new ways to build images for what brands need today.",
          tags: ["Art Direction", "Advertising", "Post-production", "AI Workflows", "Branding"],
        },
      };

// Un solo arreglo para las tres tarjetas: la maqueta es idéntica y así no hay
// que tocar tres bloques cada vez que cambia un detalle.
const members = [
  { ...copy.manuel, photo: manuelPhoto, alt: "Manuel Bedoya" },
  { ...copy.ana, photo: anaPhoto, alt: "Ana Prieto" },
  { ...copy.david, photo: davidPhoto, alt: "David Rodríguez" },
];
---

<section class="profiles-section bg-black text-white py-24" id="perfiles">
  <!-- Fondo decorativo. Va como <img> y no como background-image inline
       porque la CSP (style-src sin 'unsafe-inline') bloquea el atributo
       style; de paso Astro genera srcset y formatos modernos. -->
  <Image
    src={justiciaBg}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    widths={[640, 1024, 1600]}
    sizes="100vw"
    class="profiles-bg"
  />
  <div class="profiles-overlay"></div>
  <div class="container mx-auto px-6 relative z-10">

    <!-- Section header -->
    <div class="mb-16">
      <p class="sec-label">{copy.sectionLabel}</p>
      <h2 class="sec-title">
        {copy.sectionTitle}<br/>
        <span class="sec-title-outline">{copy.sectionTitleOutline}</span>
      </h2>
    </div>

    <!-- Team grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-white/[0.06] max-w-7xl mx-auto">
      {members.map((member, i) => (
        <article class="team-card" data-card>
          <div class="card-top-line"></div>

          {/* La foto es el disparador principal: es lo que la gente ve y toca.
              El botón de abajo repite la acción con texto, para teclado y
              lectores de pantalla. */}
          <div class="member-photo-wrap" data-photo>
            <Image
              src={member.photo}
              alt={member.alt}
              class="member-photo"
              loading="lazy"
              decoding="async"
              widths={[320, 480, 660]}
              sizes="(min-width: 1024px) 26vw, (min-width: 640px) 60vw, 90vw"
            />
          </div>

          <p class="member-role">{member.role}</p>
          <h3 class="member-name">
            {member.name.split('\n').map((line) => <span>{line}<br/></span>)}
          </h3>

          <div class="member-tags flex flex-wrap gap-2 mt-6">
            {member.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>

          <button
            class="bio-toggle"
            type="button"
            data-toggle
            aria-expanded="false"
            aria-controls={`bio-${i}`}
            data-open-label={copy.bioOpen}
            data-close-label={copy.bioClose}
          >
            <span data-label>{copy.bioOpen}</span>
            <span class="bio-toggle__icon" aria-hidden="true"></span>
          </button>

          <div class="bio-panel" id={`bio-${i}`}>
            <div class="bio-panel__inner">
              <p class="member-bio">{member.bio}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section background (justicia.jpg) + black overlay ── */
  .profiles-section {
    position: relative;
    isolation: isolate;
  }
  .profiles-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .profiles-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.62);
    z-index: 1;
  }

  /* ── Section label ── */
  .sec-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #f6ad1e;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .sec-label::before {
    content: '';
    width: 24px;
    height: 1px;
    background: #f6ad1e;
    display: block;
  }

  /* ── Section title ── */
  .sec-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(52px, 7vw, 88px);
    line-height: 0.92;
    letter-spacing: 0.02em;
    color: #ffffff;
  }
  .sec-title-outline {
    font-family: 'Bebas Neue', sans-serif;
    -webkit-text-stroke: 1.5px #f6ad1e;
    color: transparent;
  }

  /* ── Card ── */
  .team-card {
    /* Columna flexible para que la cita quede pegada al fondo y las tres
       tarjetas cierren a la misma altura pese a bios de largo distinto. */
    display: flex;
    flex-direction: column;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    /* Con tres columnas el padding fijo de 44px ahogaba la caja de texto. */
    padding: clamp(32px, 2.8vw, 48px) clamp(26px, 2.4vw, 44px);
    position: relative;
    overflow: hidden;
    transition: background 0.3s ease;
  }
  .team-card:hover { background: rgba(0, 0, 0, 0.7); }

  .card-top-line {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(to right, #f6ad1e, transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  .team-card:hover .card-top-line { transform: scaleX(1); }

  /* ── Member role ── */
  .member-role {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #f6ad1e;
    margin-bottom: 10px;
    line-height: 1.6;
  }

  /* ── Member name ── */
  .member-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(44px, 4vw, 64px);
    line-height: 0.9;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  /* ── Photo ── */
  .member-photo-wrap {
    display: block;
    width: 100%;
    /* 4:5 en vez del 3:4 del original: deja ver cara y hombros sin que la
       tarjeta se alargue de más con tres columnas. */
    aspect-ratio: 4 / 5;
    margin-bottom: 26px;
    padding: 0;
    border: 1px solid rgba(246,173,30,0.2);
    border-radius: 2px;
    overflow: hidden;
    cursor: pointer;
  }
  .member-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) contrast(1.05);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s ease;
  }
  .team-card:hover .member-photo { transform: scale(1.04); }
  .team-card[data-open] .member-photo {
    transform: scale(1.06);
    filter: grayscale(0.55) contrast(1.05);
  }

  /* ── Bio: plegada hasta el clic ── */
  .bio-toggle {
    padding: 14px 0 0;
    border: 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    background: none;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #f6ad1e;
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .bio-toggle:hover { color: #ffffff; }

  .bio-toggle__icon {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }
  .bio-toggle__icon::before,
  .bio-toggle__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 12px;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s ease;
  }
  .bio-toggle__icon::after { transform: rotate(90deg); }
  .team-card[data-open] .bio-toggle__icon::after { transform: rotate(0deg); }

  /* El truco de grid 0fr → 1fr anima la altura sin medirla en JS. */
  .bio-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.4s ease;
  }
  .bio-panel__inner {
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s linear 0.5s;
  }
  .team-card[data-open] .bio-panel__inner {
    visibility: visible;
    transition-delay: 0s;
  }
  .team-card[data-open] .bio-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .member-bio { padding-top: 20px; }

  @media (prefers-reduced-motion: reduce) {
    .bio-panel,
    .member-photo,
    .bio-toggle__icon::before,
    .bio-toggle__icon::after { transition: none; }
  }

  /* ── Bio ── */
  .member-bio {
    font-family: 'DM Mono', monospace;
    font-size: 15px;
    color: rgba(255,255,255,0.55);
    line-height: 1.8;
  }

  /* ── Tags ── */
  .tag {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 6px 14px;
    transition: all 0.3s;
  }
  .team-card:hover .tag {
    border-color: rgba(246,173,30,0.25);
    color: rgba(255,255,255,0.8);
  }

  .member-tags { margin-bottom: 30px; }

  @media (max-width: 1024px) {
    .member-bio { font-size: 16px; }
  }
  @media (max-width: 640px) {
    .team-card { padding: 36px 24px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-card]").forEach((card) => {
    const toggle = card.querySelector<HTMLButtonElement>("[data-toggle]");
    const photo = card.querySelector<HTMLElement>("[data-photo]");
    const label = card.querySelector<HTMLElement>("[data-label]");
    if (!toggle || !label) return;

    const setOpen = (open: boolean) => {
      card.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      label.textContent = open
        ? toggle.dataset.closeLabel ?? ""
        : toggle.dataset.openLabel ?? "";
    };

    const flip = () => setOpen(!card.hasAttribute("data-open"));

    toggle.addEventListener("click", flip);
    photo?.addEventListener("click", flip);
  });
</script>
