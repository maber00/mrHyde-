---
export interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const copy =
  lang === "es"
    ? {
        sectionLabel: "Método",
        sectionTitle: "CÓMO",
        sectionTitleOutline: "TRABAJAMOS",
        stmt1: "Primero la idea.",
        stmt2: "Después, todo es posible.",
        stmt3: "No partimos de una estética de moda ni de una herramienta. Partimos de un problema de comunicación y buscamos la forma audiovisual más interesante y pertinente de resolverlo.",
        steps: [
          {
            num: "01",
            title: "DESMONTAR EL PROBLEMA",
            body: "Entendemos qué necesita comunicar la marca, qué percepción quiere cambiar y qué convenciones dominan su categoría.",
          },
          {
            num: "02",
            title: "ENCONTRAR LA TENSIÓN CREATIVA",
            body: "Buscamos una contradicción, una verdad humana, una oportunidad visual o una perspectiva que permita reinterpretar el problema.",
          },
          {
            num: "03",
            title: "EXPLORAR VARIAS IDEAS",
            body: "Desarrollamos rutas conceptuales distintas y evaluamos cuál ofrece mayor originalidad, pertinencia, potencial visual y viabilidad.",
          },
          {
            num: "04",
            title: "ELEGIR CÓMO PRODUCIRLA",
            body: "Rodaje, fotografía, animación, generación con IA o una combinación: la técnica responde a la idea y al presupuesto disponible. ¿Tu proyecto es confidencial? Si lo pides, lo producimos bajo Zero Data Retention.",
          },
          {
            num: "05",
            title: "COMPROBAR QUE FUNCIONA",
            body: "Evaluamos la claridad del mensaje, la originalidad de la propuesta, la calidad de ejecución y su adecuación al objetivo comercial.",
          },
        ],
      }
    : {
        sectionLabel: "Method",
        sectionTitle: "HOW",
        sectionTitleOutline: "WE WORK",
        stmt1: "First the idea.",
        stmt2: "Then, anything is possible.",
        stmt3: "We do not start from a trendy aesthetic or a tool. We start from a communication problem and look for the most interesting and relevant audiovisual way to solve it.",
        steps: [
          {
            num: "01",
            title: "TAKE THE PROBLEM APART",
            body: "We understand what the brand needs to communicate, which perception it wants to change and which conventions dominate its category.",
          },
          {
            num: "02",
            title: "FIND THE CREATIVE TENSION",
            body: "We look for a contradiction, a human truth, a visual opportunity or a point of view that lets us reinterpret the problem.",
          },
          {
            num: "03",
            title: "EXPLORE SEVERAL IDEAS",
            body: "We develop distinct conceptual routes and evaluate which offers the most originality, relevance, visual potential and feasibility.",
          },
          {
            num: "04",
            title: "CHOOSE HOW TO PRODUCE IT",
            body: "Live action, photography, animation, AI generation or a combination: the technique answers to the idea and the available budget. Is your project confidential? On request, we produce it under Zero Data Retention.",
          },
          {
            num: "05",
            title: "CHECK THAT IT WORKS",
            body: "We evaluate the clarity of the message, the originality of the proposal, the quality of execution and its fit with the commercial objective.",
          },
        ],
      };
---

<section class="bg-black text-white py-24" id="proceso">
  <div class="container mx-auto px-6">

    <!-- Header -->
    <div class="mb-16">
      <p class="sec-label">{copy.sectionLabel}</p>
      <h2 class="sec-title">
        {copy.sectionTitle}<br/>
        <span class="sec-title-outline">{copy.sectionTitleOutline}</span>
      </h2>
    </div>

    <!-- Layout: sticky left + steps right -->
    <div class="approach-layout">

      <!-- Sticky statement -->
<div class="approach-sticky">
  <p class="stmt-line1">{copy.stmt1}</p>
  <p class="stmt-line2">{copy.stmt2}</p>
  <p class="stmt-body">{copy.stmt3}</p>
  <div class="video-wrap">
    <iframe
      data-src="https://player.vimeo.com/video/1191699225?background=1&autoplay=1&loop=1&muted=1&controls=0&title=0&byline=0&portrait=0&dnt=1"
      src="about:blank"
      title={lang === 'es' ? 'Video de fondo' : 'Background video'}
      class="video-iframe"
      frameborder="0"
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
      aria-hidden="true"
      tabindex="-1"
    ></iframe>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent pointer-events-none"></div>
  </div>
</div>

      <!-- Steps -->
      <div class="approach-steps">
        {copy.steps.map((step) => (
          <div class="a-step">
            <span class="a-num">{step.num}</span>
            <div>
              <h3 class="a-title">{step.title}</h3>
              <p class="a-body">{step.body}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Section label ── */
  .sec-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #f6ad1e;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .sec-label::before {
    content: '';
    width: 24px;
    height: 1px;
    background: #f6ad1e;
    display: block;
  }

  /* ── Section title ── */
  .sec-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(52px, 7vw, 88px);
    line-height: 0.92;
    letter-spacing: 0.02em;
    color: #ffffff;
  }
  .sec-title-outline {
    font-family: 'Bebas Neue', sans-serif;
    -webkit-text-stroke: 1.55px #f6ad1e;
    color: transparent;
  }

  /* ── Layout ── */
  .approach-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .approach-layout {
      grid-template-columns: 1fr 1.4fr;
      gap: 80px;
      align-items: start;
    }
  }
  .video-wrap {
  position: relative;
  overflow: hidden;
  background: #000;
  height: 240px;
  margin-top: 24px;
}
.video-iframe {
  position: absolute;
  top: 50%; left: 50%;
  width: 160%; height: 160%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

  /* ── Sticky statement ── */
  .approach-sticky {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (min-width: 1024px) {
    .approach-sticky {
      position: sticky;
      top: 120px;
    }
  }

  .stmt-line1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    color: #ffffff;
    letter-spacing: 0.02em;
  }
  .stmt-line2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    -webkit-text-stroke: 1px #f6ad1e;
    color: transparent;
    letter-spacing: 0.02em;
  }
  .stmt-body {
    font-family: 'DM Mono', monospace;
    font-size: 17px;
    color: rgba(255,255,255,0.55);
    line-height: 1.85;
    margin-top: 8px;
    max-width: 340px;
  }

  /* ── Steps ── */
  .approach-steps {
    display: flex;
    flex-direction: column;
  }

  .a-step {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 24px;
    padding: 32px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    transition: border-color 0.3s ease;
  }
  .a-step:first-child { border-top: 1px solid rgba(255,255,255,0.07); }
  .a-step:hover { border-color: rgba(246,173,30,0.2); }

  .a-num {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: #f6ad1e;
    padding-top: 4px;
  }

  .a-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(22px, 2.5vw, 32px);
    line-height: 1;
    color: #ffffff;
    letter-spacing: 0.03em;
    margin-bottom: 12px;
    transition: color 0.3s ease;
  }
  .a-step:hover .a-title { color: #f6ad1e; }

  .a-body {
    font-family: 'DM Mono', monospace;
    font-size: 17px;
    color: rgba(255,255,255,0.5);
    line-height: 1.85;
  }
</style>