---
import ServicePage from "../../layouts/ServicePage.astro";

const features = [
  {
    num: "01",
    title: "YOUR CONTENT IS NOT STORED",
    body: "Material entering the generation pipeline is not kept on third-party servers beyond processing. No copy remains, nothing is indexed, nothing is reused.",
  },
  {
    num: "02",
    title: "NO HUMAN REVIEWS IT",
    body: "With ZDR enabled, no Google operator reviews the generated content. Your brand's confidential material stays confidential.",
  },
  {
    num: "03",
    title: "NO EXTERNAL MODEL TRAINING",
    body: "Your brief, your unannounced campaign and your visual identity are not used to train any AI model. What is yours stays yours.",
  },
  {
    num: "04",
    title: "CONTRACTUAL GUARANTEE FROM GOOGLE",
    body: "Not a marketing promise: it is a contractual condition of Google Vertex AI. When you ask for it, your project is produced under that framework.",
  },
];

const faqs = [
  {
    q: "What is Zero Data Retention in audiovisual production?",
    a: "Zero Data Retention (ZDR) means your brand's content is not stored, not reviewed by humans, and does not train any external AI model. On request, Sr. Hide produces your project on Google Vertex AI with ZDR enabled. It is a contractual guarantee from Google.",
  },
  {
    q: "Why does Zero Data Retention matter for my brand?",
    a: "It matters if you handle unannounced campaigns, sensitive content or work in regulated sectors (pharma, financial, legal, government). Without ZDR, material passing through AI tools can be stored or used to train models. With ZDR, that does not happen.",
  },
  {
    q: "Is every project produced under Zero Data Retention?",
    a: "No. We choose tools according to what each idea needs, and not all of them operate under ZDR. If your project is confidential, tell us in the brief and we produce it on Google Vertex AI with ZDR enabled.",
  },
  {
    q: "How do I verify that Zero Data Retention is real?",
    a: "ZDR is a documented condition of Google Cloud / Vertex AI, not a claim of ours. We can explain exactly which services and infrastructure we operate on and why your content is protected under the agreement with Google.",
  },
];
---

<ServicePage
  lang="en"
  title="Zero Data Retention Video Production | Sr. Hide Colombia"
  description="Video production under Zero Data Retention on Google Vertex AI, available when your project requires it. Your content is not stored, not reviewed by humans and never trains external models."
  label="Confidentiality"
  h1="ZERO DATA RETENTION"
  h1Outline="VIDEO PRODUCTION"
  breadcrumbName="Zero Data Retention"
  serviceName="Zero Data Retention video production"
  serviceType="AI video production under Zero Data Retention on Google Vertex AI"
  lead="Is your project confidential? On request, we produce it with Zero Data Retention (ZDR) enabled on Google Vertex AI. In practice it means your brand's content is not stored on third-party servers, no Google human reviews it, and it is not used to train any external AI model. It is a contractual guarantee from Google, not a marketing promise."
  features={features}
  faqs={faqs}
  ctaText="Is your content confidential or your sector regulated? Let's talk about producing without exposing your material."
  ctaLabel="Talk to the team →"
  altEsPath="/zero-data-retention-produccion-audiovisual/"
  altEnPath="/en/zero-data-retention-video-production/"
/>
